# Copy to .env for local dev. In production, set these in Vercel → Settings → Environment Variables.

# Supabase
SUPABASE_URL=https://mjhosrblavjdxirayvqt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                      # ❗ secret — never commit. Take from Supabase Dashboard → Settings → API → service_role.

# OpenAI
OPENAI_API_KEY=                                 # ❗ secret

# Exchange rates (GET /api/rates)
# Fiat comes from Frankfurter, which needs no key. Crypto comes from CoinGecko:
# without this key, crypto quotes are returned as unavailable (provider_access),
# never as a guessed price. Set only through Vercel's managed secrets, and only
# once a CoinGecko account and its terms have been approved for this app.
COINGECKO_DEMO_API_KEY=                         # ❗ secret — sent as the x-cg-demo-api-key header, never in a URL

# App Store Server API (needed only when PAYWALL_ENABLED=true on iOS)
APPSTORE_ISSUER_ID=                             # UUID from App Store Connect → Users and Access → Integrations
APPSTORE_KEY_ID=                                # 10-char key ID
APPSTORE_PRIVATE_KEY=                           # multi-line PEM (-----BEGIN PRIVATE KEY----- ...)
APPSTORE_BUNDLE_ID=com.mykyta.SumIt

# Feature flags
PARSE_LIMIT_BASIC=100                           # parses/month for Basic tier
ALLOW_ANONYMOUS_PARSE=false                     # if true, /api/parse skips auth (dev only)
